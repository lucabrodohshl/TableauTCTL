  level 2/.style={sibling distance=33mm, level distance=16mm},
  level 3/.style={level distance=16mm},
  every node/.style={align=center, font=\small},
  edge from parent/.style={draw, -}
]
\node {$N_0\!:\{\mathrm{AG}_{[0,4]}\tEU{p}{q}{[1,2]},\mathrm{AG}_{[0,3]}\neg q\}$\\ $x{=}0$}
  child {
    node {$N_1\!:\{\tEU{p}{q}{[1,2]},\neg q\}$\\ $x\in[0,3]$}
    child {
      node {$\{q,\neg q\}$\\ $x\in[1,2]$\\ $\CLOSED$}
      edge from parent node[left,font=\scriptsize,pos=.55]{$(\mathbf{U}^\bullet,\text{stop})$}
    }
    child {
      node {$\{p,\EX(\tEU{p}{q}{[1,2]})^\bullet,\neg q\}$\\ $x\in[0,3]$}
      child {
        node {$\{\EX(\tEU{p}{q}{[1,2]})^\bullet,\neg q\}$\\ $x\in(2,3]$\\ $\CLOSED$}
