      }
      edge from parent node[right,font=\scriptsize,pos=.55]{$(\mathbf{U}^\bullet,\text{go})$}
    }
    edge from parent node[right,font=\scriptsize]{$(\mathbf{R}^\bullet,\in\kI)$}
  };
\end{tikzpicture}}
\subcaption{%$\mathrm{AG}_{[0,4]}\tEU{p}{q}{[1,2]}\land\mathrm{AG}_{[0,3]}\neg q$: the inner check closes on both branches, so $\Sat(\mathrm{AG}_{[0,4]}\tEU{p}{q}{[1,2]})=\emptyset$ and thenode closes -- \textbf{UNSAT}.
}\label{fig:ex-unsat}
\end{subfigure}
\hfill
